# Copiar para .env e preencher. O .env nunca é commitado.
#
# O estudo roda o benchmark completo em TRÊS engines, um por provedor — as três
# chaves são necessárias para reproduzir a run inteira. Para reproduzir só a
# análise (tabelas e paper a partir dos traces publicados), nenhuma é.

GEMINI_API_KEY=             # gemini-3.5-flash-lite (engine primário + transformações)
ANTHROPIC_API_KEY=          # claude-haiku-4-5
OPENAI_API_KEY=             # gpt-5.6-luna

# Teto de custo por execução, em US$. Linha de aborto, não orçamento: a run
# completa dos 3 engines custou US$ 66,69 (gemini 15,93 + haiku 44,66 +
# luna 6,10). Ver config/prices.yaml para os preços por modelo.
MAX_COST_USD_PER_RUN=70
